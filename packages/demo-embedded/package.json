  "license": "AGPL-3.0-or-later OR LicenseRef-Sterfive-Commercial",
  "author": "Sterfive SAS <contact@sterfive.com> (https://sterfive.com)",
  "homepage": "https://sterfive.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-opcua/node-i3x.git",
    "directory": "packages/demo-embedded"
  },
  "description": "End-to-end demo: OPC UA server + i3X REST API wired via PseudoSession",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "i3x-demo": "./dist/index.js",
    "i3x-demo-client": "./dist/client.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-AGPL-3.0",
    "LICENSING.md"
  ],
  "scripts": {
    "build": "tsup",
    "start": "npx tsx src/index.ts",
    "demo": "npx tsx src/index.ts",
    "demo:remote": "npx tsx src/demo-remote.ts",
    "client": "npx tsx src/client.ts"
  },
  "dependencies": {
    "@node-i3x/core": "0.9.11",
    "@node-i3x/opcua-connector": "0.9.11",
    "@node-i3x/pseudo-session-connector": "0.9.11",
    "@node-i3x/rest-server": "0.9.11",
    "fastify": "^5.10.0",
    "@fastify/cors": "^11.3.0",
    "fastify-plugin": "^6.0.0",
    "node-opcua": "^2.175.1",
    "node-opcua-certificate-manager": "^2.175.1",
    "node-opcua-client": "^2.175.1",
    "node-opcua-secure-channel": "^2.175.1",
    "node-opcua-address-space": "^2.175.1",
    "node-opcua-address-space-base": "^2.175.1",
    "node-opcua-data-model": "^2.175.1",
    "node-opcua-data-value": "^2.175.1",
    "node-opcua-nodeid": "^2.175.1",
    "node-opcua-pseudo-session": "^2.175.1",
    "node-opcua-service-browse": "^2.175.1",
    "node-opcua-status-code": "^2.175.1",
    "node-opcua-variant": "^2.175.1",
    "node-opcua-types": "^2.175.1",
    "node-opcua-constants": "^2.175.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.23.1"
  }
